# Obligatoria. Tiene que ser EXACTAMENTE la misma que AUTH_JWT_SECRET en
# apps/backend/.env: este frontend verifica la cookie de sesion con este
# mismo secreto, sin llamar al backend (verificar un JWT es pura
# criptografia). Genera una con: openssl rand -base64 32
AUTH_JWT_SECRET=""

# URL absoluta del backend, para las paginas (Server Component) que le
# piden datos y para los lib/api/*.ts que llama el navegador.
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Mismo valor que COOKIE_DOMAIN en apps/backend/.env (vacio en local).
# Hace falta con el prefijo NEXT_PUBLIC_ porque components/flash-banner.tsx
# lo usa desde el navegador para borrar el aviso con el mismo Domain con el
# que el backend lo puso.
NEXT_PUBLIC_COOKIE_DOMAIN=""
