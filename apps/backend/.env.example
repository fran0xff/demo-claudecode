# Opcional en local: sin esta variable, prisma.config.ts usa "file:./dev.db".
DATABASE_URL="file:./dev.db"

# Obligatoria. Genera una con: openssl rand -base64 32
# Tiene que ser EXACTAMENTE la misma que AUTH_JWT_SECRET en apps/frontend/.env:
# el frontend verifica la cookie de sesion con este mismo secreto, sin llamar
# al backend, y una firma HS256 solo se valida con la clave que la firmo.
AUTH_JWT_SECRET=""

# Origen exacto del frontend, para CORS (Access-Control-Allow-Origin no
# puede ser "*" cuando se mandan credenciales). En local, el puerto en el
# que corra "npm run dev" de apps/frontend.
FRONTEND_ORIGIN="http://localhost:3000"

# Dominio de la cookie de sesion. Vacio en local (los dos apps comparten
# "localhost" aunque esten en puertos distintos, asi que no hace falta).
# En produccion, el dominio raiz compartido por los dos subdominios, con el
# punto delante: ".tudominio.com" (asi la ven tanto app.tudominio.com como
# api.tudominio.com).
COOKIE_DOMAIN=""
