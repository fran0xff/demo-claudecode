# Postgres (Supabase). En local, usa el pooler (Session mode, puerto 5432):
# el hostname de conexión directa de Supabase es IPv6-only y muchas redes no
# tienen salida IPv6. Sácalo de Project Settings → Database → Connection
# Pooling en tu proyecto de Supabase.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres"

# Mismo Postgres, pero en un esquema aparte (`facturas_test`) para no mezclar
# datos de test con los de desarrollo. `npm test` lo crea y migra solo la
# primera vez (ver tests/global-setup.ts).
TEST_DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres?schema=facturas_test"

# Firma/verifica la cookie de sesión. Tiene que ser IDÉNTICA a la de
# apps/frontend — genera una con: openssl rand -base64 32
AUTH_JWT_SECRET=""

# Dominio de la cookie de sesión compartida con el frontend. Vacío en local
# (los dos apps corren en localhost, en puertos distintos); en producción,
# el dominio raíz común con el punto delante (".tudominio.com").
COOKIE_DOMAIN=""

# Origen exacto (protocolo + host + puerto) desde el que corre apps/frontend,
# para el CORS de proxy.ts.
FRONTEND_ORIGIN="http://localhost:3000"
