{
  "name": "demo-claudecode",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm run dev --workspace=@facturas/backend",
    "dev:frontend": "npm run dev --workspace=@facturas/frontend",
    "mcp:clima": "npm run start --workspace=@facturas/mcp-clima",
    "build": "npm run build --workspace=@facturas/backend && npm run build --workspace=@facturas/frontend",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
