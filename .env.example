# Copia este fichero a `.env`. La base de datos es un único fichero SQLite en la
# raíz del proyecto, así que no hace falta levantar ningún servicio.
DATABASE_URL="file:./dev.db"

# Clave para firmar los JWT de autenticación. Genera una propia con:
#   openssl rand -base64 32
# (o: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
# Sin fallback: si falta o mide menos de 32 bytes decodificados, la app falla al arrancar.
AUTH_JWT_SECRET="cambia-esto-por-una-clave-aleatoria-de-32-bytes"
